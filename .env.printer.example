# Printer Configuration Variables
# Add these to your .env file

# Print Server Configuration
VITE_PRINT_SERVER_URL=http://localhost:3001/print
VITE_PRINT_SERVER_HEALTH_CHECK=http://localhost:3001/health

# Printer Connection Settings
VITE_PRINTER_NAME=EPSON TM-T82II
VITE_PRINTER_ADDRESS=192.168.1.100
VITE_PRINTER_PORT=9100

# Enable/Disable Auto Print
VITE_AUTO_PRINT_ENABLED=true

# Print Server Backend (for local development)
PRINT_SERVER_PORT=3001
PRINT_SERVER_HOST=localhost
PRINT_SERVER_TOKEN=your-secret-token-here

# Production Print Server
PROD_PRINT_SERVER_URL=https://print.yourdomain.com/print
PROD_PRINT_SERVER_TOKEN=your-prod-token-here
